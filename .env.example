# Copy to .env and fill in. .env is git-ignored.
# TrueWatch console: Integrations > FlowPorts shows the DataWay address and the workspace token.
DATAWAY_URL=https://<site>-openway.truewatch.com
DATAWAY_TOKEN=tkn_EXAMPLE
KAFKA_TOPIC=lab-events
# java | python
APP_LANG=java
# a = app -> DataKit -> FlowPorts (security events) ; b = app -> FlowPorts directly (OTLP)
ROUTE=a
