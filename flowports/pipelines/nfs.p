# NetFlowScout event (JSON in message) -> flat columns, including the trace id from the captured traceparent header.
json(message, name, nfs_event)
json(message, connection_id, nfs_connection_id)
json(message, fields.path, http_path)
json(message, fields.query, http_query)
json(message, fields.client_ip, client_ip)
json(message, fields.client_port, client_port)
json(message, fields.status, http_status)
json(message, fields.request_headers, nfs_request_headers)
json(nfs_request_headers, traceparent, traceparent)
json(nfs_request_headers, `user-agent`, user_agent)
grok(traceparent, "00-%{WORD:trace_id}-%{WORD:parent_span_id}-%{WORD:trace_flags}")
drop_key(trace_flags)
set_tag(lab_run, "flowports-lab")
set_tag(signal, "wire")
set_tag(client_ip)
